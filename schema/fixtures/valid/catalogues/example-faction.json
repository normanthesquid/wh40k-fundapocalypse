{
   "$schema": "../../../catalogue.schema.json",
   "id": "example-faction",
   "name": "Example faction (illustrative values, not real data)",
   "kind": "Faction",
   "imports": [
      "example-library"
   ],
   "datasheetLinks": {
      "example-squad": {
         "datasheet": "example-library/example-squad",
         "battlefieldRole": "Troops",
         "addsFactionKeywords": [
            "EXAMPLE CHAPTER",
            "<EXAMPLE HOST>"
         ],
         "alternativeRoles": [
            {
               "battlefieldRole": "Elites",
               "when": {
                  "kind": "Count",
                  "scope": "Detachment",
                  "of": {
                     "kind": "Detachment",
                     "detachment": "vanguard"
                  },
                  "minimum": 1
               }
            }
         ]
      }
   },
   "detachmentChoices": {
      "example-host": {
         "name": "Host",
         "fillsPlaceholder": "<EXAMPLE HOST>",
         "minimum": 1,
         "maximum": 1,
         "options": {
            "first-host": {
               "name": "First Host",
               "keyword": "FIRST HOST"
            }
         }
      }
   },
   "detachmentAbilities": {
      "example-rally-rule": {
         "ability": "example-rally",
         "availableWhen": {
            "kind": "All",
            "conditions": [
               {
                  "kind": "Count",
                  "scope": "Detachment",
                  "of": {
                     "kind": "Detachment",
                     "detachment": "battalion"
                  },
                  "minimum": 1
               },
               {
                  "kind": "Count",
                  "scope": "Detachment",
                  "of": {
                     "kind": "AnyUnit"
                  },
                  "minimum": 3
               }
            ]
         },
         "makesCharacter": true
      }
   },
   "abilities": {
      "example-rally": {
         "name": "Example Rally",
         "text": "An illustrative detachment rule."
      }
   }
}
