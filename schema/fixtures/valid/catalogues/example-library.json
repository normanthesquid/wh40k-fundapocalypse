{
   "$schema": "../../../catalogue.schema.json",
   "id": "example-library",
   "name": "Example library (illustrative values, not real data)",
   "kind": "Library",
   "datasheets": {
      "example-defence-line": {
         "name": "Example Defence Line",
         "battlefieldRole": "Fortification",
         "cost": 4,
         "keywords": [
            "HEAVY"
         ],
         "requiredInDetachment": {
            "minimum": 1,
            "when": {
               "kind": "Count",
               "scope": "Detachment",
               "of": {
                  "kind": "Datasheet",
                  "datasheet": "example-squad"
               },
               "minimum": 1
            }
         }
      },
      "example-squad": {
         "name": "Example Squad",
         "battlefieldRole": "Elites",
         "cost": 5,
         "keywords": [
            "INFANTRY",
            "LIGHT"
         ],
         "profiles": [
            {
               "name": "Example Marine",
               "movement": {
                  "kind": "Inches",
                  "inches": 6
               },
               "weaponSkill": 3,
               "ballisticSkill": 3,
               "attacks": {
                  "kind": "Dice",
                  "count": 2,
                  "sides": 3
               },
               "wounds": 2,
               "save": 6
            }
         ],
         "wargear": [
            {
               "id": "unit-size",
               "name": "Unit size",
               "minimum": 1,
               "maximum": 1,
               "default": "five-models",
               "options": [
                  {
                     "id": "five-models",
                     "name": "5 models"
                  },
                  {
                     "id": "ten-models",
                     "name": "10 models",
                     "cost": 5
                  }
               ]
            },
            {
               "id": "sponsons",
               "name": "Sponsons",
               "maximum": 4,
               "multipleOf": 2,
               "availableWhen": {
                  "kind": "Count",
                  "scope": "Unit",
                  "of": {
                     "kind": "Option",
                     "option": "ten-models"
                  },
                  "minimum": 1
               },
               "options": [
                  {
                     "id": "heavy-bolter-sponson",
                     "name": "Heavy Bolter Sponson"
                  }
               ]
            },
            {
               "id": "heavy-weapon",
               "name": "Heavy weapon",
               "maximum": {
                  "base": 1,
                  "terms": [
                     {
                        "per": {
                           "kind": "Option",
                           "option": "ten-models"
                        },
                        "scope": "Unit",
                        "amount": 1
                     }
                  ]
               },
               "options": [
                  {
                     "id": "example-cannon",
                     "name": "Example cannon",
                     "cost": 1,
                     "maximum": {
                        "base": 1,
                        "terms": [
                           {
                              "per": {
                                 "kind": "Option",
                                 "option": "ten-models"
                              },
                              "scope": "Unit",
                              "amount": 1
                           }
                        ]
                     },
                     "addsWeapons": [
                        "example-cannon"
                     ],
                     "removesWeapons": [
                        "example-bolter"
                     ],
                     "costChanges": [
                        {
                           "when": {
                              "kind": "Count",
                              "scope": "Unit",
                              "of": {
                                 "kind": "Option",
                                 "option": "ten-models"
                              },
                              "minimum": 1
                           },
                           "increment": 1
                        }
                     ]
                  }
               ]
            },
            {
               "id": "leader",
               "name": "Leader",
               "maximum": 1,
               "options": [
                  {
                     "id": "example-sergeant",
                     "name": "Example Sergeant",
                     "cost": 1,
                     "requiredWhen": {
                        "kind": "Count",
                        "scope": "Unit",
                        "of": {
                           "kind": "Option",
                           "option": "ten-models"
                        },
                        "minimum": 1
                     },
                     "maximumPerDetachment": 1,
                     "addsProfiles": [
                        {
                           "name": "Example Sergeant",
                           "movement": {
                              "kind": "Inches",
                              "inches": 6
                           },
                           "weaponSkill": 2,
                           "ballisticSkill": 3,
                           "attacks": {
                              "kind": "Fixed",
                              "value": 3
                           },
                           "wounds": 2,
                           "leadership": 8,
                           "save": 6
                        }
                     ]
                  }
               ]
            }
         ],
         "weapons": [
            "example-bolter"
         ],
         "conditionalChanges": [
            {
               "when": {
                  "kind": "Count",
                  "scope": "Unit",
                  "of": {
                     "kind": "UniversalOption",
                     "option": "commander"
                  },
                  "minimum": 1
               },
               "addsAbilities": [
                  "deep-strike"
               ],
               "profileChanges": [
                  {
                     "profile": "Example Sergeant",
                     "increment": {
                        "leadership": 1
                     }
                  }
               ]
            }
         ]
      }
