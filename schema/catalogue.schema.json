{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://github.com/normanthesquid/wh40k-fundapocalypse/schema/catalogue.schema.json",
   "title": "Fundapocalypse catalogue (a faction or a shared library)",
   "type": "object",
   "properties": {
      "$schema": { "type": "string" },
      "id": { "$ref": "common.schema.json#/$defs/slug" },
      "name": { "type": "string", "minLength": 1 },
      "kind": {
         "description": "A Faction can be an army's primary faction; a Library only supplies entries to the catalogues that import it.",
         "enum": ["Faction", "Library"]
      },
      "imports": {
         "description": "Catalogues whose entries this one may reference with `catalogue-id/slug`. Importing makes nothing available on its own: a faction lists the library datasheets it fields in `datasheetLinks`.",
         "type": "array",
         "items": { "$ref": "common.schema.json#/$defs/slug" },
         "uniqueItems": true
      },
      "datasheets": {
         "type": "object",
         "propertyNames": { "$ref": "common.schema.json#/$defs/slug" },
         "additionalProperties": { "$ref": "#/$defs/datasheet" }
      },
      "datasheetLinks": {
         "description": "Library datasheets this faction fields, with what the faction adds to them. The link's own slug is the unit's id in this faction.",
         "type": "object",
         "propertyNames": { "$ref": "common.schema.json#/$defs/slug" },
         "additionalProperties": { "$ref": "#/$defs/datasheetLink" }
      },
      "detachmentChoices": {
         "description": "Choices made once for each detachment of this faction, e.g. a Chapter or a faction filter.",
         "type": "object",
         "propertyNames": { "$ref": "common.schema.json#/$defs/slug" },
         "additionalProperties": { "$ref": "#/$defs/detachmentChoice" }
      },
      "detachmentAbilities": {
         "description": "Abilities this faction's detachments gain, e.g. Waaagh!, each optionally conditional.",
         "type": "object",
         "propertyNames": { "$ref": "common.schema.json#/$defs/slug" },
         "additionalProperties": {
            "type": "object",
            "properties": {
               "ability": { "$ref": "common.schema.json#/$defs/reference" },
               "availableWhen": { "$ref": "common.schema.json#/$defs/condition" },
               "makesCharacter": {
                  "description": "One unit of this faction in the detachment becomes a CHARACTER with its own Warmaster Trait, e.g. Knight Lances.",
                  "const": true
               }
            },
            "required": ["ability"],
            "additionalProperties": false
         }
      },
      "weapons": {
         "type": "object",
         "propertyNames": { "$ref": "common.schema.json#/$defs/slug" },
         "additionalProperties": { "$ref": "common.schema.json#/$defs/weapon" }
      },
      "abilities": {
         "type": "object",
         "propertyNames": { "$ref": "common.schema.json#/$defs/slug" },
         "additionalProperties": { "$ref": "common.schema.json#/$defs/ability" }
      },
      "warmasterTraits": {
         "type": "object",
         "propertyNames": { "$ref": "common.schema.json#/$defs/slug" },
         "additionalProperties": { "$ref": "common.schema.json#/$defs/ability" }
      }
   },
   "required": ["id", "name", "kind"],
   "additionalProperties": false,
   "$defs": {
      "alternativeRole": {
         "description": "A battlefield role the unit takes instead when `when` holds, e.g. Troops for a cult unit.",
         "type": "object",
         "properties": {
            "battlefieldRole": { "$ref": "common.schema.json#/$defs/battlefieldRole" },
            "when": { "$ref": "common.schema.json#/$defs/condition" }
         },
         "required": ["battlefieldRole", "when"],
         "additionalProperties": false
      },
      "datasheet": {
         "type": "object",
         "properties": {
            "name": { "type": "string", "minLength": 1 },
            "battlefieldRole": { "$ref": "common.schema.json#/$defs/battlefieldRole" },
            "alternativeRoles": { "type": "array", "items": { "$ref": "#/$defs/alternativeRole" } },
            "cost": {
               "description": "Power Level of the unit with no options chosen.",
               "$ref": "common.schema.json#/$defs/powerLevel"
            },
            "factionKeywords": {
               "type": "array",
               "items": { "$ref": "common.schema.json#/$defs/keyword" },
               "uniqueItems": true
            },
            "keywords": {
               "type": "array",
               "items": { "$ref": "common.schema.json#/$defs/keyword" },
               "uniqueItems": true
            },
            "profiles": {
               "description": "The unit's stat lines. Absent only where the official datasheet prints none, such as a terrain feature.",
               "type": "array",
               "items": { "$ref": "common.schema.json#/$defs/modelProfile" },
               "minItems": 1
            },
            "weapons": {
               "description": "Weapons the unit carries before any option is chosen.",
               "type": "array",
               "items": { "$ref": "common.schema.json#/$defs/reference" }
            },
            "abilities": {
               "type": "array",
               "items": { "$ref": "common.schema.json#/$defs/reference" },
               "uniqueItems": true
            },
            "transport": {
               "description": "The transport capacity rule, as printed.",
               "type": "string",
               "minLength": 1
            },
            "wargear": {
               "description": "Option groups, in the order they are shown. Group and option ids are unique across all groups of one datasheet.",
               "type": "array",
               "items": { "$ref": "#/$defs/optionGroup" }
            },
            "conditionalChanges": {
               "description": "Changes that apply while `when` holds, such as an ability only one faction's units have.",
               "type": "array",
               "items": { "$ref": "#/$defs/conditionalChange" }
            },
            "costChanges": {
               "description": "Changes to the unit's cost while a condition holds, e.g. a power rating that rises once it takes any drones.",
               "type": "array",
               "items": { "$ref": "#/$defs/costChange" }
            },
            "availableWhen": { "$ref": "common.schema.json#/$defs/condition" },
            "requiredInDetachment": {
               "description": "A detachment must hold at least `minimum` of this unit while `when` holds, e.g. 3 Bunker Annexes once it has any part of a Castellum Stronghold.",
               "type": "object",
               "properties": {
                  "minimum": { "type": "integer", "minimum": 1 },
                  "when": { "$ref": "common.schema.json#/$defs/condition" }
               },
               "required": ["minimum", "when"],
               "additionalProperties": false
            },
            "maximumPerDetachment": { "type": "integer", "minimum": 1 },
            "maximumPerArmy": {
               "description": "1 for a named character or other unique unit.",
               "type": "integer",
               "minimum": 1
            },
            "cannotBeWarlord": {
               "description": "The unit is never a WARLORD, even as a CHARACTER Commander, e.g. a C'tan Shard.",
               "const": true
            },
            "beginsAsCommander": {
               "description": "The unit is its detachment's Commander whatever the Leadership of the others, e.g. a Tomb Ziggurat.",
               "const": true
            }
         },
         "required": ["name", "battlefieldRole", "cost", "keywords"],
         "additionalProperties": false
      },
      "datasheetLink": {
         "type": "object",
         "allOf": [{ "$ref": "common.schema.json#/$defs/keywordChanges" }],
         "properties": {
            "datasheet": { "$ref": "common.schema.json#/$defs/reference" },
            "battlefieldRole": {
               "description": "Replaces the library datasheet's role in this faction.",
               "$ref": "common.schema.json#/$defs/battlefieldRole"
            },
            "alternativeRoles": { "type": "array", "items": { "$ref": "#/$defs/alternativeRole" } },
            "cost": {
               "description": "Replaces the library datasheet's cost in this faction.",
               "$ref": "common.schema.json#/$defs/powerLevel"
            },
            "addsAbilities": {
               "type": "array",
               "items": { "$ref": "common.schema.json#/$defs/reference" },
               "uniqueItems": true
            },
            "conditionalKeywords": {
               "description": "Keywords the faction adds only when `when` holds, e.g. when the unit takes one of the library datasheet's options.",
               "type": "array",
               "items": {
                  "type": "object",
                  "allOf": [{ "$ref": "common.schema.json#/$defs/keywordChanges" }],
                  "properties": {
                     "when": { "$ref": "common.schema.json#/$defs/condition" },
                     "addsFactionKeywords": true,
                     "addsKeywords": true
                  },
                  "required": ["when"],
                  "unevaluatedProperties": false
               }
            },
            "availableWhen": { "$ref": "common.schema.json#/$defs/condition" },
            "maximumPerDetachment": { "type": "integer", "minimum": 1 },
            "maximumPerArmy": { "type": "integer", "minimum": 1 },
            "addsFactionKeywords": true,
            "addsKeywords": true
         },
         "required": ["datasheet"],
         "unevaluatedProperties": false
      },
      "detachmentChoice": {
         "type": "object",
         "properties": {
            "name": { "type": "string", "minLength": 1 },
            "minimum": { "type": "integer", "minimum": 0 },
            "maximum": { "type": "integer", "minimum": 1 },
            "options": {
               "type": "object",
               "propertyNames": { "$ref": "common.schema.json#/$defs/slug" },
               "additionalProperties": {
                  "type": "object",
                  "allOf": [{ "$ref": "common.schema.json#/$defs/keywordChanges" }],
                  "properties": {
                     "name": { "type": "string", "minLength": 1 },
                     "addsFactionKeywords": true,
                     "addsKeywords": true
                  },
                  "required": ["name"],
                  "unevaluatedProperties": false
               },
               "minProperties": 1
            }
         },
         "required": ["name", "options"],
         "additionalProperties": false
      },
      "conditionalChange": {
         "description": "What changes about a datasheet while `when` holds.",
         "type": "object",
         "allOf": [{ "$ref": "common.schema.json#/$defs/keywordChanges" }],
         "properties": {
            "when": { "$ref": "common.schema.json#/$defs/condition" },
            "addsWeapons": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/reference" } },
            "removesWeapons": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/reference" } },
            "addsAbilities": {
               "type": "array",
               "items": { "$ref": "common.schema.json#/$defs/reference" },
               "uniqueItems": true
            },
            "profileChanges": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/profileChange" } },
            "addsFactionKeywords": true,
            "addsKeywords": true
         },
         "required": ["when"],
         "minProperties": 2,
         "unevaluatedProperties": false
      },
      "growingBound": {
         "description": "A bound that grows with the unit; a fixed one is written as a plain integer.",
         "$ref": "common.schema.json#/$defs/limit",
         "required": ["terms"]
      },
      "costChange": {
         "description": "A change to a datasheet's or option's cost while `when` holds: `set` replaces it, `increment` adds to it. Changes apply in order.",
         "type": "object",
         "properties": {
            "when": { "$ref": "common.schema.json#/$defs/condition" },
            "set": { "type": "integer" },
            "increment": { "type": "integer" }
         },
         "required": ["when"],
         "oneOf": [{ "required": ["set"] }, { "required": ["increment"] }],
         "additionalProperties": false
      },
      "optionGroup": {
         "description": "A choice of options, e.g. a weapon swap or the unit's size. Leaving out `maximum` means no limit. A bound that depends on the unit, e.g. one weapon per model, is a `limit` counting its options.",
         "type": "object",
         "properties": {
            "id": { "$ref": "common.schema.json#/$defs/slug" },
            "name": { "type": "string", "minLength": 1 },
            "minimum": { "oneOf": [{ "type": "integer", "minimum": 0 }, { "$ref": "#/$defs/growingBound" }] },
            "maximum": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "$ref": "#/$defs/growingBound" }] },
            "availableWhen": {
               "description": "The whole group, its minimum included, applies only while this holds, e.g. a weapon swap for models that may all have been replaced.",
               "$ref": "common.schema.json#/$defs/condition"
            },
            "multipleOf": {
               "description": "The number of options taken must be a multiple of this, e.g. sponsons taken in pairs.",
               "type": "integer",
               "minimum": 2
            },
            "default": {
               "description": "The id of the option picked when the unit is added; one of `options`.",
               "$ref": "common.schema.json#/$defs/slug"
            },
            "options": {
               "description": "The options, in the order they are shown.",
               "type": "array",
               "items": { "$ref": "#/$defs/option" },
               "minItems": 1
            }
         },
         "required": ["id", "name", "options"],
         "additionalProperties": false
      },
      "option": {
         "description": "One wargear option. Leaving out `maximum` means no limit beyond the group's.",
         "type": "object",
         "allOf": [{ "$ref": "common.schema.json#/$defs/keywordChanges" }],
         "properties": {
            "id": { "$ref": "common.schema.json#/$defs/slug" },
            "name": { "type": "string", "minLength": 1 },
            "cost": {
               "description": "Power Level added (or, if negative, removed) each time the option is taken.",
               "type": "integer"
            },
            "costChanges": { "type": "array", "items": { "$ref": "#/$defs/costChange" } },
            "minimum": { "type": "integer", "minimum": 0 },
            "maximum": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "$ref": "#/$defs/growingBound" }] },
            "addsProfiles": {
               "description": "Model profiles the option adds to the unit, e.g. an extra model with its own characteristics.",
               "type": "array",
               "items": { "$ref": "common.schema.json#/$defs/modelProfile" },
               "minItems": 1
            },
            "addsWeapons": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/reference" } },
            "removesWeapons": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/reference" } },
            "addsAbilities": {
               "type": "array",
               "items": { "$ref": "common.schema.json#/$defs/reference" },
               "uniqueItems": true
            },
            "profileChanges": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/profileChange" } },
            "availableWhen": { "$ref": "common.schema.json#/$defs/condition" },
            "requiredWhen": {
               "description": "The unit must take the option at least once while this holds, e.g. a mark that matches the detachment's chosen god.",
               "$ref": "common.schema.json#/$defs/condition"
            },
            "addsFactionKeywords": true,
            "addsKeywords": true
         },
         "required": ["id", "name"],
         "unevaluatedProperties": false
      }
   }
}
