{
   "$schema": "https://json-schema.org/draft/2020-12/schema",
   "$id": "https://github.com/normanthesquid/wh40k-fundapocalypse/schema/common.schema.json",
   "title": "Shared Fundapocalypse definitions",
   "$defs": {
      "slug": {
         "description": "A stable id. Unique across every kind of entry in one catalogue (or the game system); never changes on rename.",
         "type": "string",
         "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "reference": {
         "description": "A bare slug in the same catalogue or the game system, or `catalogue-id/slug` in an imported catalogue.",
         "type": "string",
         "pattern": "^([a-z0-9]+(-[a-z0-9]+)*/)?[a-z0-9]+(-[a-z0-9]+)*$"
      },
      "keyword": {
         "description": "A keyword in capitals, e.g. `INFANTRY`, `<CHAPTER>` or `COMMANDER (T'AU)`. Keywords match exactly, so lower case is rejected.",
         "type": "string",
         "pattern": "^[^a-z\\s]([^a-z]*[^a-z\\s])?$"
      },
      "skillTarget": {
         "description": "The D6 result needed to hit (WS, BS), e.g. 3 for `3+`.",
         "type": "integer",
         "minimum": 2,
         "maximum": 6
      },
      "twoDiceTarget": {
         "description": "The 2D6 result needed (saves, SAP, SAT), e.g. 8 for `8+`.",
         "type": "integer",
         "minimum": 2,
         "maximum": 12
      },
      "powerLevel": {
         "type": "integer",
         "minimum": 0
      },
      "battlefieldRole": {
         "enum": [
            "HQ",
            "Troops",
            "Elites",
            "FastAttack",
            "HeavySupport",
            "Flyer",
            "DedicatedTransport",
            "LordOfWar",
            "Fortification",
            "NoForceOrgSlot"
         ]
      },
      "weaponType": {
         "enum": ["SmallArms", "Heavy", "Melee"]
      },
      "detachmentKind": {
         "description": "Core detachments unlock Special ones.",
         "enum": ["Core", "Special"]
      },
      "dice": {
         "description": "A dice roll, e.g. `2D3` is count 2, sides 3.",
         "type": "object",
         "properties": {
            "kind": { "const": "Dice" },
            "count": { "type": "integer", "minimum": 1 },
            "sides": { "enum": [3, 6] }
         },
         "required": ["kind", "count", "sides"],
         "additionalProperties": false
      },
      "fixed": {
         "type": "object",
         "properties": { "kind": { "const": "Fixed" }, "value": { "type": "integer", "minimum": 0 } },
         "required": ["kind", "value"],
         "additionalProperties": false
      },
      "movement": {
         "oneOf": [
            {
               "type": "object",
               "properties": { "kind": { "const": "Inches" }, "inches": { "type": "integer", "minimum": 0 } },
               "required": ["kind", "inches"],
               "additionalProperties": false
            },
            {
               "description": "A minimum and maximum move, as for aircraft (e.g. 20\"-60\").",
               "type": "object",
               "properties": {
                  "kind": { "const": "Range" },
                  "minimum": { "type": "integer", "minimum": 0 },
                  "maximum": { "type": "integer", "minimum": 0 }
               },
               "required": ["kind", "minimum", "maximum"],
               "additionalProperties": false
            },
            {
               "description": "The unit cannot move (printed as `-`).",
               "type": "object",
               "properties": { "kind": { "const": "Immobile" } },
               "required": ["kind"],
               "additionalProperties": false
            }
         ]
      },
      "unitAttacks": {
         "oneOf": [{ "$ref": "#/$defs/fixed" }, { "$ref": "#/$defs/dice" }]
      },
      "weaponAttacks": {
         "oneOf": [
            { "$ref": "#/$defs/fixed" },
            { "$ref": "#/$defs/dice" },
            {
               "description": "Printed as `User`: the bearer's own Attacks.",
               "type": "object",
               "properties": { "kind": { "const": "User" } },
               "required": ["kind"],
               "additionalProperties": false
            },
            {
               "description": "Printed as `x2`: the bearer's Attacks multiplied.",
               "type": "object",
               "properties": { "kind": { "const": "UserMultiplied" }, "multiplier": { "type": "integer", "minimum": 2 } },
               "required": ["kind", "multiplier"],
               "additionalProperties": false
            }
         ]
      },
      "weaponRange": {
         "oneOf": [
            {
               "type": "object",
               "properties": { "kind": { "const": "Inches" }, "inches": { "type": "integer", "minimum": 1 } },
               "required": ["kind", "inches"],
               "additionalProperties": false
            },
            {
               "description": "Printed as `*`: the weapon's text gives the range.",
               "type": "object",
               "properties": { "kind": { "const": "Special" } },
               "required": ["kind"],
               "additionalProperties": false
            }
         ]
      },
      "modelProfile": {
         "description": "One model profile. A characteristic printed as `-` is left out.",
         "type": "object",
         "properties": {
            "name": { "type": "string", "minLength": 1 },
            "movement": { "$ref": "#/$defs/movement" },
            "weaponSkill": { "$ref": "#/$defs/skillTarget" },
            "ballisticSkill": { "$ref": "#/$defs/skillTarget" },
            "attacks": { "$ref": "#/$defs/unitAttacks" },
            "wounds": { "type": "integer", "minimum": 1 },
            "leadership": { "type": "integer", "minimum": 1 },
            "save": { "$ref": "#/$defs/twoDiceTarget" }
         },
         "required": ["name", "movement", "wounds", "save"],
         "additionalProperties": false
      },
      "profileChange": {
         "description": "How a wargear option changes a model profile. `set` replaces values; `increment` adds to them (negative to decrease).",
         "type": "object",
         "properties": {
            "profile": { "description": "The profile's name; every profile when left out.", "type": "string" },
            "set": {
               "type": "object",
               "properties": {
                  "movement": { "$ref": "#/$defs/movement" },
                  "weaponSkill": { "$ref": "#/$defs/skillTarget" },
                  "ballisticSkill": { "$ref": "#/$defs/skillTarget" },
                  "attacks": { "$ref": "#/$defs/unitAttacks" },
                  "wounds": { "type": "integer", "minimum": 1 },
                  "leadership": { "type": "integer", "minimum": 1 },
                  "save": { "$ref": "#/$defs/twoDiceTarget" }
               },
               "additionalProperties": false,
               "minProperties": 1
            },
            "increment": {
               "type": "object",
               "properties": {
                  "attacks": { "type": "integer" },
                  "wounds": { "type": "integer" },
                  "leadership": { "type": "integer" }
               },
               "additionalProperties": false,
               "minProperties": 1
            }
         },
         "anyOf": [
            { "properties": { "set": true }, "required": ["set"] },
            { "properties": { "increment": true }, "required": ["increment"] }
         ],
         "additionalProperties": false
      },
      "ability": {
         "type": "object",
         "properties": {
            "name": { "type": "string", "minLength": 1 },
            "text": { "type": "string", "minLength": 1 }
         },
         "required": ["name", "text"],
         "additionalProperties": false
      },
      "weapon": {
         "description": "A weapon profile. Range is left out for melee weapons; a value printed as `-` is left out.",
         "type": "object",
         "properties": {
            "name": { "type": "string", "minLength": 1 },
            "type": { "$ref": "#/$defs/weaponType" },
            "range": { "$ref": "#/$defs/weaponRange" },
            "attacks": { "$ref": "#/$defs/weaponAttacks" },
            "antiPersonnel": { "description": "SAP: the roll to damage infantry-type targets.", "$ref": "#/$defs/twoDiceTarget" },
            "antiTank": { "description": "SAT: the roll to damage vehicle-type targets.", "$ref": "#/$defs/twoDiceTarget" },
            "text": { "description": "Special rules printed with the weapon.", "type": "string", "minLength": 1 }
         },
         "required": ["name", "type"],
         "if": { "properties": { "type": { "const": "Melee" } } },
         "then": { "not": { "properties": { "range": true }, "required": ["range"] } },
         "else": { "properties": { "range": true }, "required": ["range"] },
         "additionalProperties": false
      },
      "countTarget": {
         "description": "What a condition or a limit counts.",
         "oneOf": [
            {
               "type": "object",
               "properties": { "kind": { "const": "Datasheet" }, "datasheet": { "$ref": "#/$defs/reference" } },
               "required": ["kind", "datasheet"],
               "additionalProperties": false
            },
            {
               "type": "object",
               "properties": { "kind": { "const": "Keyword" }, "keyword": { "$ref": "#/$defs/keyword" } },
               "required": ["kind", "keyword"],
               "additionalProperties": false
            },
            {
               "type": "object",
               "properties": { "kind": { "const": "Role" }, "battlefieldRole": { "$ref": "#/$defs/battlefieldRole" } },
               "required": ["kind", "battlefieldRole"],
               "additionalProperties": false
            },
            {
               "description": "A wargear option. Without `datasheet`, an option of the same datasheet.",
               "type": "object",
               "properties": {
                  "kind": { "const": "Option" },
                  "option": { "$ref": "#/$defs/slug" },
                  "datasheet": { "$ref": "#/$defs/reference" }
               },
               "required": ["kind", "option"],
               "additionalProperties": false
            },
            {
               "description": "Everything taken from one of the same datasheet's option groups, e.g. its sponsons.",
               "type": "object",
               "properties": { "kind": { "const": "OptionGroup" }, "group": { "$ref": "#/$defs/slug" } },
               "required": ["kind", "group"],
               "additionalProperties": false
            },
            {
               "description": "An option of a catalogue's detachment choice, e.g. a faction filter.",
               "type": "object",
               "properties": { "kind": { "const": "DetachmentChoice" }, "option": { "$ref": "#/$defs/reference" } },
               "required": ["kind", "option"],
               "additionalProperties": false
            },
            {
               "type": "object",
               "properties": { "kind": { "const": "Detachment" }, "detachment": { "$ref": "#/$defs/slug" } },
               "required": ["kind", "detachment"],
               "additionalProperties": false
            },
            {
               "type": "object",
               "properties": { "kind": { "const": "DetachmentKind" }, "detachmentKind": { "$ref": "#/$defs/detachmentKind" } },
               "required": ["kind", "detachmentKind"],
               "additionalProperties": false
            },
            {
               "type": "object",
               "properties": { "kind": { "const": "AnyUnit" } },
               "required": ["kind"],
               "additionalProperties": false
            }
         ]
      },
      "countScope": {
         "enum": ["Unit", "Detachment", "Army"]
      },
      "condition": {
         "description": "When something is available or applies. Built from counts combined with All, Any and Not.",
         "oneOf": [
            {
               "description": "How many of `of` the scope contains, within `minimum`..`maximum` (each optional).",
               "type": "object",
               "properties": {
                  "kind": { "const": "Count" },
                  "scope": { "$ref": "#/$defs/countScope" },
                  "of": { "$ref": "#/$defs/countTarget" },
                  "minimum": { "type": "integer", "minimum": 0 },
                  "maximum": { "type": "integer", "minimum": 0 }
               },
               "required": ["kind", "scope", "of"],
               "anyOf": [
                  { "properties": { "minimum": true }, "required": ["minimum"] },
                  { "properties": { "maximum": true }, "required": ["maximum"] }
               ],
               "additionalProperties": false
            },
            {
               "type": "object",
               "properties": { "kind": { "const": "PrimaryFaction" }, "faction": { "$ref": "#/$defs/slug" } },
               "required": ["kind", "faction"],
               "additionalProperties": false
            },
            {
               "type": "object",
               "properties": {
                  "kind": { "enum": ["All", "Any"] },
                  "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" }, "minItems": 2 }
               },
               "required": ["kind", "conditions"],
               "additionalProperties": false
            },
            {
               "type": "object",
               "properties": { "kind": { "const": "Not" }, "condition": { "$ref": "#/$defs/condition" } },
               "required": ["kind", "condition"],
               "additionalProperties": false
            }
         ]
      },
      "limit": {
         "description": "A number that can grow or shrink with the army: `base` plus `amount` for each `per` counted in `scope`, never below 0.",
         "type": "object",
         "properties": {
            "base": { "type": "integer", "minimum": 0 },
            "terms": {
               "type": "array",
               "items": {
                  "type": "object",
                  "properties": {
                     "per": { "$ref": "#/$defs/countTarget" },
                     "scope": { "$ref": "#/$defs/countScope" },
                     "amount": { "type": "integer" }
                  },
                  "required": ["per", "scope", "amount"],
                  "additionalProperties": false
               },
               "minItems": 1
            }
         },
         "required": ["base"],
         "additionalProperties": false
      },
      "keywordChanges": {
         "description": "Keywords an option, a link or a choice adds.",
         "type": "object",
         "properties": {
            "addsFactionKeywords": { "type": "array", "items": { "$ref": "#/$defs/keyword" }, "uniqueItems": true },
            "addsKeywords": { "type": "array", "items": { "$ref": "#/$defs/keyword" }, "uniqueItems": true }
         }
      }
   }
}
