   "abilities": {
      "warhound-void-shields": {
         "name": "Warhound Void Shields",
         "text": "At the start of the Damage phase, remove one blast marker from this unit. Small blast markers must be removed before large blast markers."
      },
      "infernal-god-engine": {
         "name": "Infernal God-engine",
         "text": "You can re-roll Morale tests taken for this unit."
      },
      "reactor-overload": {
         "name": "Reactor Overload",
         "text": "In the Damage phase, damage must be resolved for units with this ability before damage is resolved for any other units (including SUPER-HEAVY units). If this unit is destroyed, before removing it from the battlefield, roll a D12 for each other unit within 6” of this unit; on a 4+ place two blast markers next to the unit being rolled for."
      },
      "warlord-void-shields": {
         "name": "Warlord Void Shields",
