   "abilities": {
      "aegis-defense-line": {
         "name": "Aegis Defense Line",
         "text": "An Aegis Defence Line is a unit that contains 4 large shield section models and 4 small shield section models. After this unit is set up, it is treated as an Obstacle, and is no longer considered to be a unit for any rules purposes."
      },
      "static-defence-network": {
         "name": "Static Defence Network",
         "text": "When this unit is set up, each model must be placed so that it is in end-to-end contact with at least one other model from this unit."
      },
      "aegis-defense-line-2": {
         "name": "Aegis Defense Line",
         "text": "This unit can only be included in a Detachment that contains at least one Aegis Defence Line unit, and does not take up a Detachment slot. When this unit is set up, it must be placed within 6\" of an Aegis Defence Line from its Detachment; if it is not possible to do so, this unit is treated as having been destroyed."
      },
      "emplacement-weapom": {
         "name": "Emplacement Weapom",
         "text": "Unless a friendly INFANTRY unit is within 1\" of this unit, then when this unit makes a Shoot action it must target either the closest enemy unit or the closest enemy unit that can FLY: if more than one such unit is equally close, select one of those units to target."
      },
      "imperial-defence-line": {
         "name": "Imperial Defence Line",
         "text": "An Imperial Defence Line is a unit that contains either 2 trench section models and up to 4 end section models, or 3 defence emplacement section models and up to 2 end section models. After this unit is set up, it is treated as an Obstacle, and is no longer considered to be a unit for any rules purposes."
      },
      "wall-of-martyrs": {
         "name": "Wall of Martyrs",
         "text": "When this unit is set up, each model must be set up so that it is in end-to-end contact with at least one other WALL OF MARTYRS model."
      },
      "restricted-fire-points": {
         "name": "Restricted Fire Points",
         "text": "No more than one unit can make use of this unit’s Open-topped ability each turn – that unit can contain no more than 5 models."
      },
      "automated-weapons": {
         "name": "Automated Weapons",
         "text": "Unless a friendly INFANTRY unit is embarked aboard this unit, then when this unit makes a Shoot action it must target the closest enemy unit or the closest enemy unit that can FLY: if more than one such unit is equally close, select one of those units to target."
      },
      "imperial-bunker": {
         "name": "Imperial Bunker",
         "text": "This unit can transport up to 10 INFANTRY models."
      },
      "fully-automated-weapons": {
         "name": "Fully Automated Weapons",
         "text": "When this unit makes a Shoot action it must target the closest enemy unit. Weapons with the Anti-air ability this unit is equipped with can instead target the closest enemy unit that can FLY. If more than one such unit is equally close, select one of those units to target."
      },
      "projected-void-shields": {
         "name": "Projected Void Shields",
         "text": "Improve the Save characteristic (to a maximum of 3+) of friendly units by 1 whilst they are wholly within 12\" of this unit."
      },
      "skyshield-landing-pad": {
         "name": "Skyshield Landing Pad",
         "text": "At the start of the Damage phase, you can remove one blast marker from one friendly AIRCRAFT unit that is on top of this unit. Small blast markers must be removed before large blast markers."
      },
      "threat-level-rising": {
         "name": "Threat Level Rising",
         "text": "Add 1 to wound rolls for attacks made by this unit if it has any blast markers next to it."
      },
      "mighty-bulwark": {
         "name": "Mighty Bulwark",
         "text": "Units embarked aboard this transport can be targeted by enemy units when using ranged weapons and are treated as obscured targets. Add 1 to saving throws taken for units embarked aboard this transport."
      },
      "primaris-redoubt": {
         "name": "Primaris Redoubt",
         "text": "This unit can only be included in a Fortification Network Detachment that includes no other units. This unit begins the battle as the Commander of its Detachment."
      },
      "realm-of-battle": {
         "name": "Realm of Battle",
         "text": "This unit is a feature of a Realm of Battle tile, and as such forms part of the battlefield. Once the tile has been placed, this unit it treated as an Obstacle and is not considered to be a unit for any rules purposes until the first turn begins. When this unit is destroyed it is not removed from the battlefield: instead it is treated as a Defensible Terrain feature and is not considered to be a unit for any rules purposes."
      },
      "fire-points": {
         "name": "Fire Points",
         "text": "No more than one unit can make use of this unit’s Open-topped ability each turn – that unit can contain no more than 10 models."
      },
      "automated-weapons-2": {
         "name": "Automated Weapons",
         "text": "Unless a friendly INFANTRY unit is embarked aboard this unit, then when this unit makes a Shoot action it must target the closest enemy unit. Weapons with the Anti-air ability this unit is equipped with can instead target the closest enemy unit that can FLY. If more than one such unit is equally close, select one of those units to target."
      },
      "extensive-firepoints": {
         "name": "Extensive Firepoints",
         "text": "No more than two units can make use of this unit’s Open-topped ability each turn – those units combined can contain no more than 15 models."
      }
   },
   "imports": [
      "weapons"
   ]
}
