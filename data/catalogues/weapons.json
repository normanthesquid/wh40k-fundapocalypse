   "abilities": {
      "thunderhawk-cluster-bombs": {
         "name": "Thunderhawk Cluster Bombs",
         "text": "When a unit with Thunderhawk Cluster Bombs finishes making a Move action, select one enemy unit it moved over whilst making that Move action. Roll six D6, subtracting 1 from each result if that unit is a Character; for each result of 4+ place one blast marker next to that unit."
      },
      "siege-shield": {
         "name": "Siege Shield",
         "text": "If this unit has a Siege Shield, it has a Save characteristic of 4+."
      },
      "lord-cypher": {
         "name": "Lord Cypher",
         "text": "You can re-roll hit rolls for attacks made by friendly FALLEN units whilst they are within 6\" of this unit."
      },
      "blazing-weapons": {
         "name": "Blazing Weapons",
         "text": "This unit can make a Shoot action in a turn in which it Fell Back."
      },
      "fallen-angels": {
         "name": "Fallen Angels",
         "text": "Re-roll hit rolls of 1 for attacks made by this unit with ranged weapons."
      }
   }
