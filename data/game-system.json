   "abilities": {
      "barrage": {
         "name": "Barrage",
         "text": "Attacks made with this weapon can target units that are not visible to the firing unit."
      },
      "destroyer": {
         "name": "Destroyer",
         "text": "If a wound roll for an attack made with a weapon with this ability is successful, place two blast markers next to the target unit instead of one."
      },
      "witchfire": {
         "name": "Witchfire",
         "text": "You can re-roll wound rolls for attacks made with this weapon that target units whose leadership characteristic is less than that of the firing unit."
      },
      "inferno": {
         "name": "Inferno",
         "text": "Attacks made with this weapon automatically score a hit (no hit roll is made)."
      },
      "anti-air": {
         "name": "Anti-air",
         "text": "Add 2 to hit rolls for attacks made with this weapon that target AIRCRAFT units."
      },
      "rapid-fire": {
         "name": "Rapid Fire",
         "text": "Double the attacks characteristic of this weapon if the target is with in half of the weapon's range."
      },
      "supercharge": {
         "name": "Supercharge",
         "text": "Before a unit attacks with this weapon, it can super charge it. If it does, then until the end of the turn add 1 to wound rolls for attacks made with this weapon, but each time you roll an unmodified hit roll of 1 for an attack with this weapon place one blast marker next to the firing unit."
      },
      "sniper": {
         "name": "Sniper",
         "text": "Add 2 to hit rolls made with this weapon that target CHARACTERS."
      },
      "one-use-only": {
         "name": "One Use Only",
         "text": "This weapon can be only used to make attacks once per battle."
      },
      "siege-weapon": {
         "name": "Siege Weapon",
         "text": "TODO"
      },
      "apocalyptic-destroyer": {
         "name": "Apocalyptic Destroyer",
         "text": "If a wound roll for an attack made with a weapon with this ability is successful, place four blast markers next to the target unit instead of one."
      },
      "infiltrators": {
         "name": "Infiltrators",
         "text": "When this unit is set up on the battlefield, it can be set up anywhere that is wholly within 24\" of its Detachment's Commander, even if this is outside its deployment zone (it cannot be set up within the deployment zone of its controlling player's opponent or within 9\" of any enemy units, and can only be set up garrisoning a Defensible Terrain feature if that terrain feature is wholly within 24\" of its Detachment's Commander).\n\nOnly place an Out of Command marker next to this unit if, at the start of the Orders phase, it is more than 24\" from its Detachment's Commander (this marker is removed if, at the end of any Move action, the unit is within 24\" of its Detachment's Commander).\n\nIf this unit is garrisoning Defensible Terrain, unmodified saving throws of 5+ are automatically successful, irrespective of this unit's Save characteristic."
      },
      "engines-of-war": {
         "name": "Engines of War",
         "text": "Super-heavy units in a Detachment carrying out an Aimed Fire or Advance order can make one Shoot action and one Fight action (instead of only being able to do one of these). All other rules for that order still apply."
      },
      "destroyed": {
         "name": "Destroyed",
         "text": "Each time a Super-heavy unit is destroyed, the controlling player rolls one D12 before removing it from the battlefield. On a 10+ that unit explodes or collapses in such a way as to crush those nearby; place one blast marker next to every unit (excluding Super-heavy units) that is within 6\" of the destroyed unit before removing it from the battlefield.  If the destroyed Super-heavy unit is a Transport, units must attempt to disembark before these blast markers are applied."
      },
      "terror-troops": {
         "name": "Terror Troops",
         "text": "Subtract 1 from the Leadership characteristic of units whilst they are within 6\" of any enemy units with this ability."
      },
      "deep-strike": {
         "name": "Deep Strike",
         "text": "During deployment, this unit can be set up in Tactical Reserves instead of being set up on the battlefield. When this unit arrives as reinforcements, set it up anywhere on the battlefield that is more than 9\" from any enemy units. No more than half the total number of units in your army can be set up in Tactical Reserves, even if every unit in your army has this ability."
      },
      "ignore-damage-6": {
         "name": "Ignore Damage (6+)",
         "text": "Each time you fail a saving throw for this unit, roll one D6. If the roll equals or exceeds the number in brackets, no damage marker is placed next to this unit. For example, if this unit has the 'Ignore Damage (5+)' ability, a roll of 5 or more is required to prevent a damage marker being placed. If a unit has more than one Ignore Damage ability, it can only use one each time you fail a saving throw for that unit."
      },
      "ignore-damage-5": {
         "name": "Ignore Damage (5+)",
         "text": "Each time you fail a saving throw for this unit, roll one D6. If the roll equals or exceeds the number in brackets, no damage marker is placed next to this unit. For example, if this unit has the 'Ignore Damage (5+)' ability, a roll of 5 or more is required to prevent a damage marker being placed. If a unit has more than one Ignore Damage ability, it can only use one each time you fail a saving throw for that unit."
      },
      "stealth": {
         "name": "Stealth",
         "text": "Subtract 1 from hit rolls for attacks made with ranged weapons that target this unit."
      },
      "supersonic": {
         "name": "Supersonic",
         "text": "Subtract 1 from hit rolls for attacks made with ranged weapons that target this unit. Hit rolls for attacks made with melee weapons that target this unit automatically fail (no hit roll is made) unless the unit making the attack can FLY."
      },
      "open-topped": {
         "name": "Open-topped",
         "text": "Units embarked aboard this unit can still make a Shoot action, measuring distances and visibilty from this unit, unless this unit is in base contact with an enemy unit. All negative modifiers that would apply to this unit were it to make a Shoot action also apply to units embarked aboard this unit when they make a Shoot action."
      },
      "immobile": {
         "name": "Immobile",
         "text": "This unit is never Out of Command: an Out of Command marker is never placed next to it. When measuring distances to and from this unit, measure to and from the closest point of this unit."
      },
      "hover": {
         "name": "Hover",
         "text": "Distances are measured to and from this unit’s hull, even though it has a base."
      },
      "objective-secured-troops": {
         "name": "Objective Secured (Troops)",
         "text": "If one or more units from your army with this ability are within 6\" of an objective marker, and no enemy units with this ability are within 6\" of the same objective marker, you control that objective marker."
      }
   },
   "warmasterTraits": {
      "01-master-strategist": {
         "name": "01 - Master Strategist",
